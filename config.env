# Purrfessorrr Slothhh settings.
# Environment variables with the same name override these values.

# Server (bound to localhost only: this app never leaves your machine)
HOST=127.0.0.1
PORT=8765
OPEN_BROWSER=true

# Uploads
MAX_UPLOAD_MB=200
UPLOAD_DIR=data/uploads

# Multiplies the cats' working animation (0.5 = twice as fast, 2 = half speed).
# The numbers are computed from every row either way.
CAT_SPEED=1.0

# Chat engine: "gemma" (rules + Gemma 3 running in Ollama on this computer) or "local" (rules only).
# With "gemma", the chat falls back to the rules whenever Ollama is not running. See README "Gemma and Ollama".
ENGINE=gemma
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
# Seconds to wait for one Gemma answer before the rules answer instead.
OLLAMA_TIMEOUT=45
