# Purrfessorrr Slothhh settings.
# Environment variables with the same name override these values.

# true  = cats run on scripted mock data (no pandas / Ollama needed)
# false = use the real analysis backend (not built yet)
MOCK_MODE=true

# Server (bound to localhost only: this app never leaves your machine)
HOST=127.0.0.1
PORT=8765
OPEN_BROWSER=true

# Uploads
MAX_UPLOAD_MB=200
UPLOAD_DIR=data/uploads

# Shown in the settings panel; used by the real backend later
OLLAMA_URL=http://127.0.0.1:11434
MODEL_NAME=gemma3:4b

# Mock tuning
# Multiplies every mock duration (0.5 = twice as fast, 2 = half speed)
MOCK_SPEED=1.0
# Chance (0..1) that a cat trips over its yarn and reports an error
MOCK_ERROR_RATE=0.0
